  "screens": [
    {
      "id": "000a-app-shell",
      "path": "/",
      "role": "department-head",
      "waitFor": "role=heading[name=\"Welcome, Lena\"]",
      "states": [
        {
          "state": "default"
        },
        {
          "state": "nav-drawer-open",
          "actions": [
            {
              "click": "button[aria-label=\"Expand navigation\"]:visible, button[aria-label=\"Open navigation\"]:visible >> nth=-1"
            },
            {
              "waitFor": "p.bf-shell__group >> nth=0"
            },
            {
              "waitFor": "role=menuitem[name=\"Utilization\"]"
            },
            {
              "hover": "div.bf-shell__brand"
            }
          ]
        },
        {
          "state": "notifications-open",
          "actions": [
            {
              "click": "role=button[name=\"Notifications\"]"
            },
            {
              "waitFor": "text=You are all caught up"
            }
          ]
        },
        {
          "state": "account-menu-open",
          "actions": [
            {
              "click": "button.bf-header__avatar"
            },
            {
              "waitFor": "role=menuitem[name=\"Sign out\"]"
            }
          ]
        },
        {
          "state": "employee-forbidden",
          "role": "employee",
          "path": "/audit-log",
          "waitFor": "role=heading[name=\"You do not have access to this page\"]"
        },
        {
          "state": "employee-home",
          "role": "employee",
          "waitFor": "role=heading[name=\"Nothing to show here yet\"]"
        },
        {
          "state": "placeholder",
          "role": "ceo",
          "path": "/reports",
          "waitFor": "role=heading[name=\"Reports is not open yet\"]"
        },
        {
          "state": "not-found",
          "role": "employee",
          "path": "/no-such-page",
          "waitFor": "role=heading[name=\"Page not found\"]"
        },
        {
          "state": "platform-operator",
          "role": "super-admin",
          "waitFor": "text=You are signed in as a platform operator."
        }
      ]
    },
    {
      "id": "000b-sign-in-pages",
      "path": "/signed-out",
      "waitFor": "role=heading[name=\"You have signed out\"]",
      "states": [
        {
          "state": "signed-out"
        },
        {
          "state": "sign-in-problem",
          "path": "/sign-in-problem",
          "waitFor": "role=heading[name=\"We could not sign you in\"]"
        }
      ]
    },
    {
      "id": "019-budget-list",
      "path": "/budgets/list",
      "role": "department-head",
      "waitFor": "[data-testid=row-EX-EU]",
      "states": [
        {
          "state": "default"
        },
        {
          "state": "empty",
          "actions": [
            {
              "fill": ["[data-testid=search]", "no budget like this"]
            },
            {
              "waitFor": "role=heading[name=\"No budgets match\"]"
            }
          ]
        }
      ]
    },
    {
      "id": "020-create-budget",
      "path": "/budgets/new?parent=70000000-0000-4000-8000-000000000004",
      "role": "department-head",
      "waitFor": "role=heading[name=\"Create budget\"]",
      "states": [
        {
          "state": "default",
          "actions": [
            {
              "fill": ["[data-testid=name]", "Europe Team Offsite"]
            },
            {
              "fill": ["[data-testid=amount]", "2500"]
            },
            {
              "waitFor": "text=Available before"
            }
          ]
        }
      ]
    },
    {
      "id": "020a-budget-plan-import",
      "path": "/budgets/plans",
      "role": "finance-admin",
      "waitFor": "[data-testid=tie-out]",
