        "[data-testid=tie-out]",
        "[data-testid=version-lines]",
        ".bf-pv__meta",
        ".bf-pv__head"
      ],
      "states": [
        {
          "state": "map-columns",
          "actions": [
            {
              "click": "[data-testid=import-plan]"
            },
            {
              "hover": "#import-title"
            },
            {
              "fill": [
                "[data-testid=import-csv]",
                "Program code,Program,Budget (USD),Entity\nEX-2027,Employee Experience FY2027,\"110,000.00\",HYL-US\nWB-2027,Wellbeing FY2027,abc,HYL-XX"
              ]
            }
          ]
        },
        {
          "state": "review",
          "actions": [
            {
              "click": "[data-testid=import-plan]"
            },
            {
              "hover": "#import-title"
            },
            {
              "fill": [
                "[data-testid=import-csv]",
                "Program code,Program,Budget (USD),Entity\nEX-2027,Employee Experience FY2027,\"110,000.00\",HYL-US\nWB-2027,Wellbeing FY2027,abc,HYL-XX"
              ]
