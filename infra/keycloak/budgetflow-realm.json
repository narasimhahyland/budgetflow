{
  "realm": "budgetflow",
  "displayName": "BudgetFlow",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "budgetflow",
  "internationalizationEnabled": false,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 300,
  "maxFailureWaitSeconds": 300,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 200,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@budgetflow.example.test",
    "fromDisplayName": "BudgetFlow",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "super-admin",
        "description": "BudgetFlow role: super-admin"
      },
      {
        "name": "org-admin",
        "description": "BudgetFlow role: org-admin"
      },
      {
        "name": "ceo",
        "description": "BudgetFlow role: ceo"
      },
      {
        "name": "finance-admin",
        "description": "BudgetFlow role: finance-admin"
      },
      {
        "name": "finance-controller",
        "description": "BudgetFlow role: finance-controller"
      },
      {
        "name": "budget-owner",
        "description": "BudgetFlow role: budget-owner"
      },
      {
        "name": "department-head",
        "description": "BudgetFlow role: department-head"
      },
      {
        "name": "regional-manager",
        "description": "BudgetFlow role: regional-manager"
      },
      {
        "name": "location-manager",
        "description": "BudgetFlow role: location-manager"
      },
      {
        "name": "event-organizer",
        "description": "BudgetFlow role: event-organizer"
      },
      {
        "name": "employee",
        "description": "BudgetFlow role: employee"
      },
      {
        "name": "auditor",
        "description": "BudgetFlow role: auditor"
      },
      {
        "name": "integration-admin",
        "description": "BudgetFlow role: integration-admin"
      },
      {
        "name": "analyst",
        "description": "BudgetFlow role: analyst"
      }
    ]
  },
  "clients": [
    {
      "clientId": "budgetflow-web",
      "name": "BudgetFlow web app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4201/*",
        "http://localhost:4202/*",
        "http://localhost:${BF_WEB_PORT:4200}/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:4201/*##http://localhost:4202/*##http://localhost:${BF_WEB_PORT:4200}/*"
      },
      "protocolMappers": [
        {
          "name": "budgetflow-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "budgetflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "budgetflow-api",
      "name": "BudgetFlow API",
      "publicClient": false,
      "secret": "${BF_KC_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "budgetflow-e2e",
      "name": "BudgetFlow local test client (direct grant, local stack only)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "budgetflow-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "budgetflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "hyland-sso",
      "displayName": "Hyland SSO",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "budgetflow-broker",
        "clientSecret": "${BF_KC_BROKER_CLIENT_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "issuer": "http://localhost:${BF_KEYCLOAK_PORT:8080}/realms/hyland-sso",
        "authorizationUrl": "http://localhost:${BF_KEYCLOAK_PORT:8080}/realms/hyland-sso/protocol/openid-connect/auth",
        "logoutUrl": "http://localhost:${BF_KEYCLOAK_PORT:8080}/realms/hyland-sso/protocol/openid-connect/logout",
        "tokenUrl": "http://localhost:8080/realms/hyland-sso/protocol/openid-connect/token",
        "userInfoUrl": "http://localhost:8080/realms/hyland-sso/protocol/openid-connect/userinfo",
        "jwksUrl": "http://localhost:8080/realms/hyland-sso/protocol/openid-connect/certs",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid email profile",
        "syncMode": "LEGACY"
      }
    }
  ],
