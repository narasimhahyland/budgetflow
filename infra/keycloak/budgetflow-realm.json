{
  "realm": "budgetflow",
  "displayName": "BudgetFlow",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "super-admin",
        "description": "BudgetFlow role: super-admin"
      },
      {
        "name": "org-admin",
        "description": "BudgetFlow role: org-admin"
      },
      {
        "name": "ceo",
        "description": "BudgetFlow role: ceo"
      },
      {
        "name": "finance-admin",
        "description": "BudgetFlow role: finance-admin"
      },
      {
        "name": "finance-controller",
        "description": "BudgetFlow role: finance-controller"
      },
      {
        "name": "budget-owner",
        "description": "BudgetFlow role: budget-owner"
      },
      {
        "name": "department-head",
        "description": "BudgetFlow role: department-head"
      },
      {
        "name": "regional-manager",
        "description": "BudgetFlow role: regional-manager"
      },
      {
        "name": "location-manager",
        "description": "BudgetFlow role: location-manager"
      },
      {
        "name": "event-organizer",
        "description": "BudgetFlow role: event-organizer"
      },
      {
        "name": "employee",
        "description": "BudgetFlow role: employee"
      },
      {
        "name": "auditor",
        "description": "BudgetFlow role: auditor"
      },
      {
        "name": "integration-admin",
        "description": "BudgetFlow role: integration-admin"
      },
      {
        "name": "analyst",
        "description": "BudgetFlow role: analyst"
      }
    ]
  },
  "clients": [
    {
      "clientId": "budgetflow-web",
      "name": "BudgetFlow web app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4201/*",
        "http://localhost:4202/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "budgetflow-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "budgetflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "budgetflow-api",
      "name": "BudgetFlow API",
      "publicClient": false,
      "secret": "${BF_KC_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "budgetflow-e2e",
      "name": "BudgetFlow local test client (direct grant, local stack only)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "budgetflow-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "budgetflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
