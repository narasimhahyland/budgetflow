# Dev-only placeholders for the local Docker Compose stack. scripts/stack.sh uses .env when it exists,
# otherwise this file. Copy to .env (gitignored) to change ports per worktree. Never reuse these values.

# Host ports (bound to 127.0.0.1)
BF_PG_PORT=5432
BF_API_PORT=3000
BF_KEYCLOAK_PORT=8080
BF_MAILPIT_PORT=8025
BF_MINIO_PORT=9000
BF_WEB_PORT=4200

# PostgreSQL: owner role runs migrations and the seed; bf_app (API) and bf_worker (worker) never bypass RLS
BF_PG_DB=budgetflow
BF_PG_OWNER_USER=bf_owner
BF_PG_OWNER_PASSWORD=bf-owner-dev-only
BF_PG_APP_PASSWORD=bf-app-dev-only
BF_PG_WORKER_PASSWORD=bf-worker-dev-only

# Keycloak (realm budgetflow, imported from infra/keycloak)
BF_KC_ADMIN_USER=admin
BF_KC_ADMIN_PASSWORD=kc-admin-dev-only
BF_KC_API_CLIENT_SECRET=api-client-dev-only
# Password of every seeded test user (one per role); used by API scenarios and journeys
BF_E2E_PASSWORD=Budgetflow-dev-only-1
BF_E2E_CLIENT_ID=budgetflow-e2e

# MinIO (DocumentStore from Phase 5)
BF_MINIO_ROOT_USER=budgetflow
BF_MINIO_ROOT_PASSWORD=minio-dev-only

# AI provider for functional runs (deterministic fake from Phase 13)
BF_AI_PROVIDER=fake
