{
  "name": "@budgetflow/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "gate": "bash scripts/gate.sh",
    "gate:static": "bash scripts/gate.sh static",
    "gate:functional": "bash scripts/gate.sh functional",
    "gate:visual": "bash scripts/gate.sh visual",
    "secret-scan": "sh scripts/secret-scan.sh --staged",
    "harness:check": "sh scripts/validate-harness.sh",
    "functional:api": "nx run api-e2e:functional-api",
    "functional:e2e": "nx run web-e2e:functional-e2e",
    "e2e:visual": "bash scripts/visual/pw-docker.sh npx playwright test -c apps/web-e2e/playwright.config.ts --project=visual-light",
    "e2e:update-snapshots": "bash scripts/visual/pw-docker.sh npx playwright test -c apps/web-e2e/playwright.config.ts --project=visual-light --update-snapshots",
    "visual:headroom": "bash scripts/visual/headroom.sh",
    "visual:capture": "node scripts/visual/capture.mjs",
    "visual:parity": "node scripts/visual/design-parity.mjs",
    "visual:selftest": "node scripts/visual/self-test.mjs",
    "lint:styles": "stylelint \"{apps,libs}/**/*.scss\" --allow-empty-input",
    "satori:check": "sdsc check all"
  },
