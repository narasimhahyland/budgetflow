# Copy to the repo root as .cursorignore (Cursor protects that file from agent writes).
# Keeps credential-bearing files out of agent and Tab context; Cursor already ignores .env* and .gitignore'd files.
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/credentials*.json
**/secrets*.json
**/*.har
infra/**/secrets/**
