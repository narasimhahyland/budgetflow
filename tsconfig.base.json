{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@bf/domain": ["./libs/domain/src/index.ts"],
      "@bf/contracts": ["./libs/contracts/src/index.ts"],
      "@bf/seed": ["./libs/seed/src/index.ts"],
      "@bf/api/db": ["./libs/api/db/src/index.ts"],
      "@bf/api/actuals": ["./libs/api/actuals/src/index.ts"],
      "@bf/api/core": ["./libs/api/core/src/index.ts"],
      "@bf/api/audit": ["./libs/api/audit/src/index.ts"],
      "@bf/api/ledger": ["./libs/api/ledger/src/index.ts"],
      "@bf/api/org": ["./libs/api/org/src/index.ts"],
      "@bf/api/budgets": ["./libs/api/budgets/src/index.ts"],
      "@bf/api/finance": ["./libs/api/finance/src/index.ts"],
      "@bf/api/integrity": ["./libs/api/integrity/src/index.ts"],
      "@bf/api/tenancy": ["./libs/api/tenancy/src/index.ts"],
      "@bf/web/data-access": ["./libs/web/data-access/src/index.ts"],
      "@bf/web/features/accounting": ["./libs/web/features/accounting/src/index.ts"],
      "@bf/web/features/auth": ["./libs/web/features/auth/src/index.ts"],
      "@bf/web/features/budgets": ["./libs/web/features/budgets/src/index.ts"],
      "@bf/web/features/finance-admin": ["./libs/web/features/finance-admin/src/index.ts"],
      "@bf/web/features/org": ["./libs/web/features/org/src/index.ts"],
      "@bf/web/shell": ["./libs/web/shell/src/index.ts"],
      "@bf/web/ui": ["./libs/web/ui/src/index.ts"],
      "@bf/api/notifications": ["./libs/api/notifications/src/index.ts"],
      "@bf/api/approvals": ["./libs/api/approvals/src/index.ts"],
      "@bf/api/documents": ["./libs/api/documents/src/index.ts"],
      "@bf/api/spend": ["./libs/api/spend/src/index.ts"],
      "@bf/api/contributions": ["./libs/api/contributions/src/index.ts"],
      "@bf/api/events": ["./libs/api/events/src/index.ts"],
      "@bf/web/features/events": ["./libs/web/features/events/src/index.ts"],
      "@bf/web/features/requests": ["./libs/web/features/requests/src/index.ts"],
      "@bf/web/features/approvals": ["./libs/web/features/approvals/src/index.ts"],
      "@bf/web/features/employee": ["./libs/web/features/employee/src/index.ts"],
      "@bf/web/features/insights": ["./libs/web/features/insights/src/index.ts"],
      "@bf/api/channels": ["./libs/api/channels/src/index.ts"],
      "@bf/web/features/mobile": ["./libs/web/features/mobile/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
