#!/bin/sh
# Blocks non-fast-forward pushes (force pushes) and deletions of main/master.
# Set BF_PREPUSH_GATE=1 to also run `scripts/gate.sh static --affected` before every push.
set -eu

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: refusing to delete $remote_ref" >&2
    status=1
    continue
  fi
  [ "$remote_sha" = "$zero" ] && continue
  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    echo "pre-push: $remote_ref has commits you have not fetched; run git pull before pushing" >&2
    status=1
  elif ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: refusing non-fast-forward push of $local_ref to $remote_ref (force push to a protected branch)" >&2
    status=1
  fi
done

[ "$status" = 0 ] || exit "$status"

if [ "${BF_PREPUSH_GATE:-0}" = 1 ]; then
  bash scripts/gate.sh static --affected
fi
